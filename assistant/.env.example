# 配置模板：复制为 .env 并按注释填写，或在部署环境里直接导出这些变量。
#
# 注意：本服务**不会**自己读取 .env 文件，它只读进程环境变量。
# 用 `export $(grep -v '^#' .env | xargs)` 之类的方式导入，或写进
# systemd/docker 的环境配置里。

# ── 本服务 ────────────────────────────────────────────────────────────────
# 长连接模式下这个端口只提供 /healthz 探活，不再是消息入口。
ASSISTANT_ADDR=:8090

# ── 企业微信智能机器人（长连接模式：BotID + Secret）──────────────────────
# 管理后台 → 工作台 → 智能机器人 → 新建机器人 → 切到「API 模式」，
# 在机器人详情页可以拿到 BotID 与 Secret。
#
# 注意：这是长连接模式的凭据。另一种「接收 URL」模式用的是
# Token + EncodingAESKey，两者不通用，别混用。
WECOM_BOT_ID=
# 属于机密，不要提交到仓库。
WECOM_BOT_SECRET=
# 一般不用改。仅在对接私有部署或自建测试服务器时才需要。
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com

# ── TodoDay 后端 ──────────────────────────────────────────────────────────
TODO_API_BASE=http://127.0.0.1:8080
TODO_USERNAME=
# 属于机密。
TODO_PASSWORD=
# 目标工作区 ID：登录网页版后看 GET /api/me 返回的 workspaces[].id。
TODO_WORKSPACE_ID=

# ── AI 解析（可选） ───────────────────────────────────────────────────────
# 两个键名等价，填其中一个即可。留空则全部使用规则解析。
KIMI_API_KEY=
# MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
ASSISTANT_MODEL=moonshot-v1-8k
# AI 调用超时。长连接没有 5 秒硬墙（被动回复才有），但仍不建议设太长。
PARSE_TIMEOUT=8s
