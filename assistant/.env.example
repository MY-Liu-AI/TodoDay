# 配置模板：复制为 .env 并按注释填写，或在部署环境里直接导出这些变量。
#
# 注意：本服务**不会**自己读取 .env 文件，它只读进程环境变量。
# 用 `export $(grep -v '^#' .env | xargs)` 之类的方式导入，或写进
# systemd/docker 的环境配置里。

# ── 本服务 ────────────────────────────────────────────────────────────────
ASSISTANT_ADDR=:8090

# ── 企业微信自建应用（五项，缺一不可） ────────────────────────────────────
# 管理后台 → 我的企业 → 企业信息，可看到企业 ID。
WECOM_CORP_ID=
# 管理后台 → 应用管理 → 自建 → 你的应用，可看到 AgentId。
WECOM_AGENT_ID=
# 同一页面的 Secret。属于机密，不要提交到仓库。
WECOM_SECRET=
# 「接收消息 → 设置API接收」里自己填的 Token，属于机密。
WECOM_TOKEN=
# 同页面生成的 EncodingAESKey，固定 43 个字符，属于机密。
WECOM_ENCODING_AES_KEY=

# ── TodoDay 后端 ──────────────────────────────────────────────────────────
TODO_API_BASE=http://127.0.0.1:8080
TODO_USERNAME=
# 属于机密。
TODO_PASSWORD=
# 目标工作区 ID：登录网页版后看地址栏 / 或用 GET /api/me 查看。
TODO_WORKSPACE_ID=

# ── AI 解析（可选） ───────────────────────────────────────────────────────
# 两个键名等价，填其中一个即可。留空则全部使用规则解析。
KIMI_API_KEY=
# MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
ASSISTANT_MODEL=moonshot-v1-8k
# AI 调用超时。必须远小于企业微信 5 秒的响应上限，否则会触发重投。
PARSE_TIMEOUT=8s
